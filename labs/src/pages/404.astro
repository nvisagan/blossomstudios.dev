---
import Labs from '../layouts/Labs.astro';
---

<Labs title="Not found">
  <section class="mx-auto max-w-[1120px] px-6 py-32 text-center">
    <span class="font-mono text-caption text-ink-faint">404</span>
    <h1 class="text-title text-ink mt-3">This experiment didn't take.</h1>
    <p class="text-body text-ink-muted mt-2">It may have been moved or composted.</p>
    <a href="/" class="inline-block mt-8 px-5 py-2.5 rounded-xl bg-ink text-surface text-small font-medium hover:bg-ink/90 transition-colors duration-200">
      Back to Labs
    </a>
  </section>
</Labs>
