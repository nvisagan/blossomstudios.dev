---
// Theme toggle button — flips between light and dark, persisting to localStorage.
// The actual theme value is set by the inline script in Head.astro before paint.
---

<button
  type="button"
  class="theme-toggle inline-flex items-center justify-center w-9 h-9 rounded-lg text-ink-muted hover:text-ink hover:bg-surface-raised transition-colors duration-200"
  aria-label="Switch theme"
  title="Switch theme"
>
  <!-- Blossom: open by day, folds into a bud at night -->
  <svg class="theme-bloom w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle class="tb-petal tb-top" cx="8" cy="5.5" r="3" />
    <circle class="tb-petal tb-left" cx="5" cy="9" r="2.6" />
    <circle class="tb-petal tb-right" cx="11" cy="9" r="2.6" />
    <circle class="tb-petal tb-bottom" cx="8" cy="11.8" r="2.1" />
    <circle class="tb-star tb-star-a" cx="13.6" cy="2.6" r="0.7" />
    <circle class="tb-star tb-star-b" cx="11.4" cy="1.4" r="0.45" />
  </svg>
</button>

<style>
  /* Selectors target :root (outside component scope) so the icon follows
   * data-theme; Astro scopes only the descendant classes. */
  .tb-petal,
  .tb-star {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.55s var(--ease-spring),
      opacity var(--dur-ui) var(--ease-soft),
      fill-opacity var(--dur-ui) var(--ease-soft);
  }

  .tb-petal {
    stroke: currentColor;
    stroke-width: 1.2;
    fill: currentColor;
    fill-opacity: 0;
  }

  .tb-star {
    fill: currentColor;
    opacity: 0;
    transform: scale(0);
  }

  /* Night: the petals fold onto one centre (8, 8.8) and fill in, so the
   * closed blossom reads as a small moon beside the stars. */
  :root[data-theme="dark"] .tb-petal { fill-opacity: 1; }
  :root[data-theme="dark"] .tb-top { transform: translate(0, 3.3px) scale(1.13); }
  :root[data-theme="dark"] .tb-left { transform: translate(3px, -0.2px) scale(1.31); }
  :root[data-theme="dark"] .tb-right { transform: translate(-3px, -0.2px) scale(1.31); }
  :root[data-theme="dark"] .tb-bottom { transform: translate(0, -3px) scale(1.62); }
  :root[data-theme="dark"] .tb-star { opacity: 1; transform: none; }
  :root[data-theme="dark"] .tb-star-b { transition-delay: 80ms; }

  @media (prefers-reduced-motion: reduce) {
    .tb-petal,
    .tb-star {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    var btns = document.querySelectorAll('.theme-toggle');
    if (!btns.length) return;

    function currentTheme() {
      return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    }

    function updateAria(theme) {
      var label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
      btns.forEach(function (btn) {
        btn.setAttribute('aria-label', label);
        btn.setAttribute('title', label);
      });
    }

    function setTheme(next) {
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      updateAria(next);
    }

    updateAria(currentTheme());

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        setTheme(currentTheme() === 'dark' ? 'light' : 'dark');
        btn.closest('details')?.removeAttribute('open');
      });
    });

    // Cross-tab sync: another tab changed the theme, mirror it here.
    window.addEventListener('storage', function (e) {
      if (e.key === 'theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
        document.documentElement.setAttribute('data-theme', e.newValue);
        updateAria(e.newValue);
      }
    });
  })();
</script>
