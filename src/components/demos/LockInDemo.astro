---
// Lock In Timer in one loop: a 25-minute session time-lapses to zero, the
// ring closes with a spring, and today's streak dot fills in.
const streak = Array.from({ length: 7 }, (_, i) => i);
---

<div class="lock" aria-hidden="true">
  <svg viewBox="0 0 320 240" fill="none">
    <circle class="glow" cx="160" cy="104" r="62" />
    <circle class="track" cx="160" cy="104" r="62" />
    <circle class="progress" cx="160" cy="104" r="62" pathLength="1" />
    {streak.map((i) => (
      <circle class:list={['streak', { today: i === 6 }]} cx={124 + i * 12} cy="200" r="3.5" />
    ))}
  </svg>

  <div class="readout">
    <span class="time"></span>
    <span class="done">
      <svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
    <span class="task">Write launch post</span>
  </div>
</div>

<style>
  @property --t {
    syntax: '<integer>';
    inherits: false;
    initial-value: 450;
  }

  .lock {
    --loop: 7s;
    position: absolute;
    inset: 0;
  }

  .lock > svg {
    width: 100%;
    height: 100%;
  }

  .lock svg * {
    transform-box: fill-box;
    transform-origin: center;
  }

  .track {
    stroke: var(--color-surface-overlay);
    stroke-width: 7;
  }

  .progress {
    stroke: var(--hue);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0.3;
    transform: rotate(-90deg);
  }

  .glow {
    fill: color-mix(in oklab, var(--hue) 12%, transparent);
    opacity: 0;
  }

  .streak {
    fill: color-mix(in oklab, var(--hue) 70%, var(--color-surface));
  }

  .streak.today {
    fill: var(--hue);
  }

  /* Readout sits over the ring centre (160, 104 in a 320×240 stage) */
  .readout {
    position: absolute;
    left: 50%;
    top: 43.3%;
    translate: -50% -50%;
    display: grid;
    justify-items: center;
    gap: 0.6cqw;
  }

  .time,
  .done {
    grid-area: 1 / 1;
  }

  .time {
    --t: 450;
    font-size: 8.5cqw;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .time::after {
    content: '07:30';
  }

  @supports (counter-reset: m round(down, 7 / 2, 1)) and (counter-reset: s mod(7, 2)) {
    .time {
      counter-reset: m round(down, var(--t) / 60, 1) s mod(var(--t), 60);
    }

    .time::after {
      content: counter(m, decimal-leading-zero) ':' counter(s, decimal-leading-zero);
    }
  }

  .done {
    width: 9cqw;
    align-self: center;
    opacity: 0;
  }

  .done path {
    stroke: var(--hue);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .task {
    grid-area: 2 / 1;
    font-size: 3cqw;
    font-weight: 500;
    color: var(--color-ink-faint);
  }

  @media (prefers-reduced-motion: no-preference) {
    .progress { animation: li-progress var(--loop) linear infinite; }
    .lock > svg { animation: li-snap var(--loop) var(--ease-spring) infinite; }
    .glow { animation: li-glow var(--loop) var(--ease-bloom) infinite; }
    .time { animation: li-time var(--loop) linear infinite; }
    .done { animation: li-done var(--loop) var(--ease-spring) infinite; }
    .streak.today { animation: li-streak var(--loop) var(--ease-spring) infinite; }
  }

  @keyframes li-progress {
    0%, 6% { stroke-dashoffset: 1; opacity: 1; }
    68%, 90% { stroke-dashoffset: 0; opacity: 1; }
    97% { stroke-dashoffset: 0; opacity: 0; }
    100% { stroke-dashoffset: 1; opacity: 0; }
  }

  @keyframes li-snap {
    0%, 68% { transform: scale(1); }
    71% { transform: scale(0.97); }
    80%, 100% { transform: scale(1); }
  }

  @keyframes li-glow {
    0%, 68% { opacity: 0; transform: scale(0.9); }
    76% { opacity: 1; transform: scale(1.12); }
    92%, 100% { opacity: 0; transform: scale(1.18); }
  }

  @keyframes li-time {
    0% { --t: 1500; opacity: 0; }
    4%, 6% { --t: 1500; opacity: 1; }
    68% { --t: 0; opacity: 1; }
    72%, 100% { --t: 0; opacity: 0; }
  }

  @keyframes li-done {
    0%, 70% { opacity: 0; transform: scale(0.4); }
    78%, 90% { opacity: 1; transform: scale(1); }
    96%, 100% { opacity: 0; transform: scale(1); }
  }

  @keyframes li-streak {
    0%, 72% { fill: transparent; stroke: var(--hue); stroke-width: 1; transform: scale(1); }
    78% { fill: var(--hue); stroke-width: 0; transform: scale(1.6); }
    86%, 100% { fill: var(--hue); stroke-width: 0; transform: scale(1); }
  }
</style>
