---
// FaviGrab in one loop: click the extension, the tab's favicon lifts off and
// lands in three sizes, then a toast confirms the files are saved.
//
// Slot geometry: icons fly from the tab favicon (85, 41) to each slot centre.
const slots = [
  { label: '16', size: 20, x: 68, y: 130, delay: 0 },
  { label: '32', size: 32, x: 128, y: 118, delay: 90 },
  { label: '64', size: 52, x: 200, y: 98, delay: 180 },
].map((s) => {
  const cx = s.x + s.size / 2;
  const cy = s.y + s.size / 2;
  return { ...s, cx, dx: 85 - cx, dy: 41 - cy, s0: (10 / s.size).toFixed(3) };
});
---

<svg class="fg" viewBox="0 0 320 240" fill="none" aria-hidden="true">
  <!-- Browser window -->
  <rect class="win" x="20" y="24" width="280" height="192" rx="14" />
  <path class="strip" d="M20 38a14 14 0 0 1 14-14h252a14 14 0 0 1 14 14v20H20z" />
  <line class="rule" x1="20" y1="58" x2="300" y2="58" />
  <circle class="dot" cx="36" cy="41" r="3" />
  <circle class="dot" cx="46" cy="41" r="3" />
  <circle class="dot" cx="56" cy="41" r="3" />

  <!-- Tab -->
  <rect class="tab" x="70" y="31" width="118" height="21" rx="7" />
  <g class="glyph" transform="translate(80 36) scale(0.625)">
    <circle cx="8" cy="6" r="3" /><circle cx="5.5" cy="9" r="2.5" /><circle cx="10.5" cy="9" r="2.5" /><circle cx="8" cy="11.5" r="2" />
  </g>
  <text class="tab-text" x="95" y="45">blossomstudios.dev</text>

  <!-- Extension button -->
  <circle class="ripple" cx="279" cy="41" r="9" />
  <g class="ext">
    <rect x="270" y="32" width="18" height="18" rx="5" />
    <path d="M279 36.5v8m-3.2-3.2 3.2 3.2 3.2-3.2" />
  </g>

  <!-- Output slots -->
  {slots.map((s) => (
    <g>
      <rect class="slot" x={s.x} y={s.y} width={s.size} height={s.size} rx={s.size / 5} style={`--delay:${s.delay}ms`} />
      <g
        class="fly"
        style={`--dx:${s.dx}px;--dy:${s.dy}px;--s0:${s.s0};--delay:${s.delay}ms`}
      >
        <g class="glyph" transform={`translate(${s.x + s.size * 0.1} ${s.y + s.size * 0.1}) scale(${(s.size * 0.8) / 16})`}>
          <circle cx="8" cy="6" r="3" /><circle cx="5.5" cy="9" r="2.5" /><circle cx="10.5" cy="9" r="2.5" /><circle cx="8" cy="11.5" r="2" />
        </g>
      </g>
      <text class="slot-label" x={s.cx} y="170" text-anchor="middle">{s.label}</text>
    </g>
  ))}

  <!-- Toast -->
  <g class="toast">
    <rect x="104" y="182" width="112" height="22" rx="11" />
    <path d="M118 193l3 3 5.5-6" />
    <text x="132" y="196.5">Saved 3 files</text>
  </g>
</svg>

<style>
  .fg {
    --loop: 6.5s;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .fg * {
    transform-box: fill-box;
    transform-origin: center;
  }

  .win { fill: var(--color-surface); stroke: var(--color-border); }
  .strip { fill: var(--color-surface-raised); }
  .rule { stroke: var(--color-border); }
  .dot { fill: var(--color-border-hover); }
  .tab { fill: var(--color-surface); stroke: var(--color-border); }

  .tab-text {
    font-size: 8.5px;
    font-weight: 500;
    fill: var(--color-ink-muted);
  }

  /* Glyphs are placed with the SVG transform attribute; keep its origin
   * at the user-space origin rather than the fill-box centre. */
  .fg .glyph {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  .glyph circle { fill: var(--color-hue-violet); }
  .glyph circle:nth-child(1) { opacity: 0.9; }
  .glyph circle:nth-child(2),
  .glyph circle:nth-child(3) { opacity: 0.7; }
  .glyph circle:nth-child(4) { opacity: 0.5; }

  .ext rect { fill: var(--hue); }
  .ext path {
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ripple {
    stroke: var(--hue);
    stroke-width: 1.5;
    opacity: 0;
  }

  .slot {
    stroke: color-mix(in oklab, var(--hue) 55%, var(--color-border));
    stroke-width: 1;
    fill: color-mix(in oklab, var(--hue) 7%, transparent);
  }

  .slot-label {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--color-ink-faint);
  }

  .toast rect { fill: var(--color-ink); }
  .toast path {
    stroke: var(--hue);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .toast text {
    font-size: 9px;
    font-weight: 600;
    fill: var(--color-surface);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ext { animation: fg-press var(--loop) var(--ease-spring) infinite; }
    .ripple { animation: fg-ripple var(--loop) var(--ease-bloom) infinite; }
    .fly { animation: fg-fly var(--loop) var(--ease-bloom) var(--delay) infinite both; }
    .slot { animation: fg-slot var(--loop) var(--ease-soft) var(--delay) infinite both; }
    .toast { animation: fg-toast var(--loop) var(--ease-bloom) infinite; }
  }

  @keyframes fg-press {
    0%, 5% { transform: scale(1); }
    8% { transform: scale(0.8); }
    14%, 100% { transform: scale(1); }
  }

  @keyframes fg-ripple {
    0%, 7% { transform: scale(0.8); opacity: 0; }
    9% { opacity: 0.7; }
    24%, 100% { transform: scale(2.4); opacity: 0; }
  }

  @keyframes fg-fly {
    0%, 12% { transform: translate(var(--dx), var(--dy)) scale(var(--s0)); opacity: 0; }
    15% { transform: translate(var(--dx), var(--dy)) scale(var(--s0)); opacity: 1; }
    24% {
      transform: translate(calc(var(--dx) * 0.55), calc(var(--dy) * 0.55 - 14px)) scale(calc(var(--s0) + 0.35));
    }
    36%, 86% { transform: none; opacity: 1; }
    94%, 100% { transform: none; opacity: 0; }
  }

  @keyframes fg-slot {
    0%, 30% { stroke-dasharray: 3 3; fill: transparent; }
    36%, 92% { stroke-dasharray: none; }
    100% { stroke-dasharray: 3 3; fill: transparent; }
  }

  @keyframes fg-toast {
    0%, 42% { transform: translateY(8px); opacity: 0; }
    50%, 86% { transform: none; opacity: 1; }
    94%, 100% { transform: translateY(4px); opacity: 0; }
  }
</style>
