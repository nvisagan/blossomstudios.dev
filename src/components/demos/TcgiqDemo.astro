---
// TCGIQ in one loop: a card flips face-up, its Fair Range fills in around
// the median, then the condition steps NM → LP and the range slides down.
---

<div class="tcg" aria-hidden="true">
  <div class="card-wrap">
    <div class="card">
      <div class="face front">
        <span class="bar-line w-60"></span>
        <span class="art"><span class="orb"></span></span>
        <span class="bar-line w-80"></span>
        <span class="bar-line w-50"></span>
      </div>
      <div class="face back"><span class="emblem"></span></div>
    </div>
  </div>

  <div class="panel">
    <span class="label">Fair Range</span>
    <span class="price"></span>
    <span class="label muted">median · recent sales</span>

    <div class="chips">
      <span class="chip-indicator"></span>
      <span class="chip">NM</span>
      <span class="chip">LP</span>
      <span class="chip">MP</span>
    </div>

    <div class="track">
      <span class="fill"></span>
      <span class="marker-rail"><span class="marker"></span></span>
    </div>
    <div class="ends"><span>low</span><span>high</span></div>
  </div>
</div>

<style>
  @property --price {
    syntax: '<integer>';
    inherits: false;
    initial-value: 24;
  }

  .tcg {
    --loop: 8s;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 7cqw;
    padding: 0 9cqw;
    color: var(--color-ink);
  }

  /* ---- Card ---- */
  .card-wrap {
    width: 31cqw;
    flex-shrink: 0;
    perspective: 600px;
  }

  .card {
    position: relative;
    aspect-ratio: 63 / 88;
    transform-style: preserve-3d;
  }

  .face {
    position: absolute;
    inset: 0;
    border-radius: 2.2cqw;
    backface-visibility: hidden;
    box-shadow: 0 2cqw 5cqw -2cqw color-mix(in oklab, var(--hue) 45%, transparent);
  }

  .front {
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    padding: 2.4cqw;
    background: linear-gradient(160deg, color-mix(in oklab, var(--hue) 22%, var(--color-surface)), var(--color-surface));
    border: 0.6cqw solid color-mix(in oklab, var(--hue) 70%, var(--color-surface));
  }

  .art {
    position: relative;
    flex: 1;
    border-radius: 1.2cqw;
    background: radial-gradient(circle at 50% 60%, color-mix(in oklab, var(--hue) 55%, var(--color-surface)), color-mix(in oklab, var(--hue) 18%, var(--color-surface)));
    display: grid;
    place-items: center;
  }

  .orb {
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: inset 0 -1cqw 0 color-mix(in oklab, var(--hue) 35%, transparent);
  }

  .bar-line {
    height: 1.4cqw;
    border-radius: 99px;
    background: color-mix(in oklab, var(--color-ink) 14%, transparent);
  }

  .w-50 { width: 50%; }
  .w-60 { width: 60%; }
  .w-80 { width: 80%; }

  .back {
    transform: rotateY(180deg);
    background: var(--color-ink);
    display: grid;
    place-items: center;
  }

  .emblem {
    width: 50%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.4cqw solid var(--hue);
    box-shadow: 0 0 0 2cqw color-mix(in oklab, var(--hue) 22%, transparent);
  }

  /* ---- Panel ---- */
  .panel {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .label {
    font-size: 3.4cqw;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink-muted);
  }

  .label.muted {
    font-weight: 500;
    color: var(--color-ink-faint);
    margin-bottom: 4cqw;
  }

  .price {
    counter-reset: price var(--price);
    font-size: 11cqw;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .price::after {
    content: '$' counter(price);
  }

  .chips {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0.8cqw;
    border-radius: 2.2cqw;
    background: var(--color-surface-overlay);
    margin-bottom: 4.5cqw;
  }

  .chip {
    position: relative;
    text-align: center;
    font-size: 3.2cqw;
    font-weight: 600;
    padding: 1cqw 0;
    color: var(--color-ink-muted);
  }

  .chip-indicator {
    position: absolute;
    top: 0.8cqw;
    bottom: 0.8cqw;
    left: 0.8cqw;
    width: calc((100% - 1.6cqw) / 3);
    border-radius: 1.6cqw;
    background: var(--color-surface);
    box-shadow: 0 0.4cqw 1.2cqw -0.4cqw rgb(0 0 0 / 0.18);
  }

  .track {
    position: relative;
    height: 2cqw;
    border-radius: 99px;
    background: var(--color-surface-overlay);
  }

  .fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--hue);
    clip-path: inset(0 30% 0 18% round 99px);
  }

  .marker-rail {
    position: absolute;
    inset: 0;
    transform: translateX(45%);
  }

  .marker {
    position: absolute;
    left: 0;
    top: 50%;
    width: 3.6cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-surface);
    border: 0.8cqw solid var(--color-ink);
    translate: -50% -50%;
  }

  .ends {
    display: flex;
    justify-content: space-between;
    margin-top: 1.6cqw;
    font-size: 2.8cqw;
    color: var(--color-ink-faint);
  }

  /* ---- Motion ---- */
  @media (prefers-reduced-motion: no-preference) {
    .card { animation: tcg-flip var(--loop) var(--ease-soft) infinite; }
    .fill { animation: tcg-fill var(--loop) var(--ease-bloom) infinite; }
    .marker-rail { animation: tcg-marker var(--loop) var(--ease-bloom) infinite; }
    .price { animation: tcg-price var(--loop) var(--ease-bloom) infinite; }
    .chip-indicator { animation: tcg-chip var(--loop) var(--ease-spring) infinite; }
  }

  @keyframes tcg-flip {
    0%, 3% { transform: rotateY(180deg); }
    13%, 88% { transform: rotateY(0deg); }
    97%, 100% { transform: rotateY(180deg); }
  }

  @keyframes tcg-fill {
    0%, 12% { clip-path: inset(0 50% 0 50% round 99px); }
    27%, 50% { clip-path: inset(0 30% 0 18% round 99px); }
    60%, 86% { clip-path: inset(0 46% 0 8% round 99px); }
    94%, 100% { clip-path: inset(0 50% 0 50% round 99px); }
  }

  @keyframes tcg-marker {
    0%, 12% { transform: translateX(50%); opacity: 0; }
    27%, 50% { transform: translateX(45%); opacity: 1; }
    60%, 86% { transform: translateX(28%); opacity: 1; }
    94%, 100% { transform: translateX(28%); opacity: 0; }
  }

  @keyframes tcg-price {
    0%, 12% { --price: 0; opacity: 0.25; }
    27%, 50% { --price: 24; opacity: 1; }
    60%, 86% { --price: 17; opacity: 1; }
    94% { --price: 17; opacity: 0; }
    100% { --price: 0; opacity: 0; }
  }

  @keyframes tcg-chip {
    0%, 52% { transform: translateX(0); }
    58%, 90% { transform: translateX(100%); }
    97%, 100% { transform: translateX(0); }
  }
</style>
